# Container-based RPM builder for AlmaLinux 8 (EPEL 8 / el8)
#
# Usage:
#   docker build -f packaging/rpm/Dockerfile.alma8 \
#     --build-arg VERSION=0.1.0 \
#     -t brix-cache-rpm-builder:alma8 .
#
#   # Extract the RPMs:
#   docker run --rm -v "$PWD/dist:/out" brix-cache-rpm-builder:alma8 \
#     cp -r /artifacts/. /out/
#
# AlmaLinux 8 notes:
#   - Based on RHEL 8 (EL8).  GCC 8 toolchain by default.
#   - Alma's nginx is linked to OpenSSL 1.1.1, while BriX requires OpenSSL 3.
#     Loading both ABIs into one nginx process is unsafe, so this target builds
#     the native, co-installable client package only. Server RPMs start at EL9.
#   - The resulting RPM carries the .el8 dist tag.
#   - Intel builds use GCC Toolset 14: GCC 8 cannot name x86-64-v2.

FROM almalinux:8 AS builder

# Ceph release to pull dev packages from.
ARG BRIX_CEPH_VERSION=18.2.2

# Step 1: bootstrap repo manager, enable PowerTools (EL8 equivalent of CRB,
# needed for jansson-devel), then install EPEL.
RUN dnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled powertools && \
    dnf install -y epel-release && \
    dnf config-manager --set-enabled epel

# Step 2: add the last official Reef repository published for EL8/AArch64.
# The moving rpm-reef alias dropped EL8 metadata; the immutable numeric repo
# keeps this EOL compatibility build reproducible.
RUN printf '[ceph-%s]\nname=Ceph %s for EL8\nbaseurl=https://download.ceph.com/rpm-%s/el8/$basearch\nenabled=1\ngpgcheck=1\ngpgkey=https://download.ceph.com/keys/release.asc\npriority=2\n' \
    "${BRIX_CEPH_VERSION}" "${BRIX_CEPH_VERSION}" "${BRIX_CEPH_VERSION}" \
    > /etc/yum.repos.d/ceph.repo

# Step 3: install all build dependencies.
RUN dnf install -y \
        gcc gcc-c++ make git pkgconfig rpm-build rpmdevtools redhat-rpm-config \
        openssl3-devel zlib-devel \
        libxml2-devel jansson-devel libcurl-devel libnghttp2-devel krb5-devel libcom_err-devel which \
        libxcrypt-devel sqlite-devel libseccomp-devel \
        liburing-devel libzstd-devel brotli-devel xz-devel bzip2-devel lz4-devel \
        librados-devel libradospp-devel libradosstriper-devel libcephfs-devel \
    && dnf clean all

# EPEL installs parallel OpenSSL 3 metadata as openssl3.pc/libssl3.pc/
# libcrypto3.pc. The source build intentionally asks for the unversioned
# pkg-config interface, so provide build-local aliases without modifying the
# system packages or selecting OpenSSL 1.1 accidentally.
RUN mkdir -p /opt/brix-openssl3-pkgconfig && \
    ln -s /usr/lib64/pkgconfig/openssl3.pc /opt/brix-openssl3-pkgconfig/openssl.pc

ENV PKG_CONFIG_PATH=/opt/brix-openssl3-pkgconfig:/usr/lib64/pkgconfig

# Retain the project's x86-64-v2 baseline on EL8 without changing its runtime
# libraries. The parallel toolset is a build dependency, not a package runtime.
RUN if [ "$(uname -m)" = x86_64 ]; then \
        dnf install -y gcc-toolset-14-gcc gcc-toolset-14-gcc-c++ \
            gcc-toolset-14-annobin-plugin-gcc && dnf clean all; \
    fi

# Explicit override only; empty means "use the version baked into the
# source" (BRIX_SERVER_VERSION_BARE in src/core/ident.h), derived below.
ARG VERSION=""

WORKDIR /build/src
COPY . .

RUN if [ -f /opt/rh/gcc-toolset-14/enable ]; then \
        . /opt/rh/gcc-toolset-14/enable; \
    fi && \
    RPMBUILD_TOPDIR=/root/rpmbuild \
    RPM_SPEC=/build/src/packaging/rpm/brix-cache-client-el8.spec \
    packaging/rpm/build-rpm.sh "${VERSION}"

RUN mkdir -p /artifacts && \
    find ~/rpmbuild/RPMS ~/rpmbuild/SRPMS -name '*.rpm' -exec cp {} /artifacts/ \;


FROM almalinux:8-minimal AS final

COPY --from=builder /artifacts /artifacts

CMD ["find", "/artifacts", "-name", "*.rpm"]
