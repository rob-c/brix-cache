---
import Layout from '../layouts/Layout.astro';
import Band from '../components/Band.astro';
import RoutingMatrix from '../components/RoutingMatrix.astro';
import Cta from '../components/Cta.astro';
import { url, REPO_URL, DOCS_URL, PROTOCOLS, AUDIENCES } from '../lib/site';

const audienceBlurb: Record<string, string> = {
  Sysadmins: 'Drop it in front of an existing xrootd server to add TLS, auth, and metrics — client and backend config unchanged.',
  Physicists: 'Keep using xrdcp, rucio, aws-cli, or a browser. Your familiar tools and workflows keep working.',
  Engineers: 'One nginx binary speaks four wire protocols over a shared core. Seven concept buckets, pluggable storage backends.',
  Stakeholders: 'WLCG-native security and protocols, built on proven nginx foundations and conformance-tested against reference XRootD.',
};

// The request pipeline — a real ordered path, so the numbered steps carry meaning.
const flow = [
  { n: '01 · ingress', label: 'clients', sub: 'xrdcp · curl · aws-cli', tint: 'var(--dav)' },
  { n: '02 · event loop', label: 'nginx module', sub: 'epoll · non-blocking', tint: 'var(--root)' },
  { n: '03 · shared core', label: 'auth · confine · cache', sub: 'metrics · path resolve', tint: 'var(--s3)' },
  { n: '04 · egress', label: 'VFS backend', sub: 'POSIX · root:// · Ceph', tint: 'var(--ftp)' },
];

const whoAccent = ['root', 'dav', 's3', 'ftp'] as const;
---

<Layout
  title="BriX-Cache"
  description="BriX-Cache teaches one nginx binary to serve a single POSIX namespace over root://, WebDAV, S3, and gsiftp:// — a modular WLCG storage interface with x509/token auth and Prometheus metrics."
  accent="root"
>
  <!-- STATUS STRIP -->
  <div class="strip" aria-hidden="true">
    <div class="wrap strip-row">
      <span><i class="led"></i>one nginx binary</span>
      <span><i class="led"></i>4 wire protocols</span>
      <span><i class="led"></i>WLCG x509 · tokens</span>
      <span><i class="led"></i>Prometheus /metrics</span>
      <span class="strip-wide"><i class="led"></i>conformance-tested vs XRootD 5.2</span>
    </div>
  </div>

  <!-- HERO -->
  <Band first={true} accent="root">
    <div class="hero">
      <div class="hero-copy stack">
        <span class="eyebrow">Modular WLCG storage interface</span>
        <h1 class="display">One file.<br />Every protocol.<br /><span class="accent">One binary.</span></h1>
        <p class="lede">
          BriX-Cache teaches one nginx binary to serve a single POSIX namespace over
          <span class="scheme" style="color:var(--root)">root://</span>
          <span class="scheme" style="color:var(--dav)">davs://</span>
          <span class="scheme" style="color:var(--s3)">s3://</span> and
          <span class="scheme" style="color:var(--ftp)">gsiftp://</span> — one shared path for
          authentication, caching, and metrics behind every door.
        </p>
        <div class="hero-actions">
          <a class="btn btn--accent" href={DOCS_URL}>Get started →</a>
          <a class="btn" href={REPO_URL}>View on GitHub ↗</a>
        </div>
        <div class="term hero-term" aria-label="The same file over four protocols">
          <div class="term-title">the same file · /data/higgs.root</div>
          <div><span class="p">$</span> xrdcp <span class="k">root://host//data/higgs.root</span> .</div>
          <div><span class="p">$</span> aws s3 cp <span class="k">s3://host/data/higgs.root</span> . <span class="c"># same server</span></div>
          <div><span class="p">$</span> curl -OL <span class="k">https://host/data/higgs.root</span> <span class="c"># same file</span></div>
          <div><span class="p">$</span> globus-url-copy <span class="k">gsiftp://host/data/higgs.root</span> file:./ <span class="c"># again</span></div>
        </div>
      </div>
      <div class="hero-signature">
        <RoutingMatrix />
      </div>
    </div>
  </Band>

  <!-- PROTOCOL CHANNELS -->
  <Band variant="sunken" id="protocols" accent="root">
    <span class="eyebrow">The wires</span>
    <h2 class="display band-head">Speak grid, cloud, and web — off the same tree.</h2>
    <div class="grid grid-3 chan-grid">
      {PROTOCOLS.map((p) => (
        <article class="panel panel--hover chan" data-accent={p.id}>
          <div class="chan-top">
            <span class="scheme chan-scheme">{p.scheme}</span>
            <span class="chan-port mono">{p.port}</span>
          </div>
          <h3 class="chan-name">{p.name}</h3>
          <p class="chan-blurb muted">{p.blurb}</p>
          <dl class="specs">
            <div class="spec-row"><dt>via</dt><dd>{p.transport}</dd></div>
            <div class="spec-row"><dt>clients</dt><dd>{p.clients}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <!-- the fourth: a GridFTP gateway, given its own wide channel -->
    <article class="panel gftp" data-accent="ftp">
      <div class="gftp-head">
        <span class="scheme gftp-scheme">gsiftp://</span>
        <h3 class="gftp-name">A full peer protocol for GridFTP.</h3>
      </div>
      <p class="gftp-blurb muted">
        A complete <span class="mono">gsiftp://</span> server terminates in the same binary — GSI / x509
        control-channel auth, parallel <span class="mono">MODE&nbsp;E</span> data streams, encrypted
        (<span class="mono">PROT&nbsp;P</span>) data channels, and server-to-server third-party copy. Like the
        other three it terminates on the shared VFS, so it serves <em>any</em> storage backend — POSIX, an S3
        or Ceph object store, or a block store — across the very same namespace
        <span class="mono">root://</span>, WebDAV, and S3 serve. Write a file with
        <span class="mono">globus-url-copy</span>, gfal2, or FTS and read it back byte-for-byte over any door.
      </p>
      <dl class="specs gftp-specs">
        <div class="spec-row"><dt>port</dt><dd>2811 + stream</dd></div>
        <div class="spec-row"><dt>via</dt><dd>GSI · MODE&nbsp;E · TLS data</dd></div>
        <div class="spec-row"><dt>clients</dt><dd>globus-url-copy · gfal2 · fts</dd></div>
      </dl>
    </article>
  </Band>

  <!-- SIGNAL PATH -->
  <Band id="how" accent="root">
    <span class="eyebrow">Signal path</span>
    <h2 class="display band-head">Four fronts in, one path to disk.</h2>
    <p class="lede muted flow-intro">
      Every protocol enters through nginx's event loop, funnels through one shared core that handles auth,
      path confinement, caching, and metrics — then reaches storage. No worker ever blocks: disk syscalls run
      on a thread pool while the worker keeps serving.
    </p>
    <ol class="flow">
      {flow.map((s, i) => (
        <li class="flow-step">
          <div class="flow-box" style={`--tint:${s.tint}`}>
            <span class="flow-n mono">{s.n}</span>
            <span class="flow-label">{s.label}</span>
            <span class="flow-sub mono">{s.sub}</span>
          </div>
          {i < flow.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
        </li>
      ))}
    </ol>
  </Band>

  <!-- TRUST + READOUT -->
  <Band variant="sunken" id="trust" accent="root">
    <span class="eyebrow">Trust &amp; readout</span>
    <div class="grid grid-2 two">
      <div class="feature">
        <h2 class="display feature-head">WLCG-native auth, checked before a byte moves.</h2>
        <p class="muted">
          GSI / x509 proxy certs with <span class="mono">kXR_sigver</span> request signing, VOMS, and WLCG
          bearer tokens with per-path scope enforcement (<span class="mono">storage.read</span> /
          <span class="mono">write</span> / <span class="mono">create</span>). Plus SSS, host allowlist,
          password, and Kerberos 5.
        </p>
        <p class="authlist">
          {['anonymous','GSI / x509','WLCG tokens','SSS','host','password','krb5'].map((m) => (
            <span class="tag mono">{m}</span>
          ))}
        </p>
      </div>
      <div class="feature" data-accent="s3">
        <h2 class="display feature-head">Every request is a metric and a log line.</h2>
        <p class="muted">
          Prometheus <span class="mono">/metrics</span> with fixed, low-cardinality labels — no per-file or
          per-user explosion. Structured access logs for every protocol, and a live HTTPS operator dashboard
          at <span class="mono">/brix/</span>.
        </p>
        <div class="term">
          <div class="term-title">GET /metrics</div>
          <div><span class="k">brix_requests_total</span>{'{op="read",status="ok"}'} <span class="c">14302</span></div>
          <div><span class="k">brix_io_bytes_read</span>{'{proto="webdav"}'} <span class="c">9.2e11</span></div>
          <div><span class="k">brix_auth_total</span>{'{method="gsi",status="ok"}'} <span class="c">4201</span></div>
        </div>
      </div>
    </div>
  </Band>

  <!-- WHO IT'S FOR -->
  <Band id="who" accent="root">
    <span class="eyebrow">By role</span>
    <h2 class="display band-head">See what matters where you sit.</h2>
    <div class="grid grid-4 whogrid">
      {AUDIENCES.map((a, i) => (
        <a class="panel panel--hover who" href={url(a.href)} data-accent={whoAccent[i]}>
          <span class="who-name">{a.label}</span>
          <p class="who-blurb muted">{audienceBlurb[a.label]}</p>
          <span class="who-go mono">Explore →</span>
        </a>
      ))}
    </div>
  </Band>

  <!-- CTA -->
  <Band accent="root">
    <Cta
      title="Point your existing clients at it."
      note="Standalone server, transparent XRootD proxy, or WebDAV perimeter — all in one nginx instance."
    />
  </Band>
</Layout>

<style>
  .band-head { margin: 0.6rem 0 1.7rem; max-width: 22ch; }

  /* status strip — an appliance readout under the header */
  .strip { border-bottom: 1px solid var(--line); background: var(--band); }
  .strip-row {
    display: flex; gap: 1.6rem; flex-wrap: wrap; padding-block: 0.5rem;
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.03em; color: var(--ink-2);
  }
  .strip-row span { display: inline-flex; align-items: center; gap: 0.55ch; }
  .led { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 5px var(--accent); }
  @media (max-width: 620px) { .strip-wide { display: none; } }

  /* hero */
  .hero { display: grid; gap: 2.6rem; align-items: center; }
  @media (min-width: 940px) { .hero { grid-template-columns: 1.02fr 0.98fr; gap: 3.2rem; } }
  .hero h1 { margin-top: 0.7rem; }
  .hero h1 .accent { color: var(--accent); }
  .hero-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .hero-term { margin-top: 0.5rem; }
  .scheme { padding-inline: 0.05em; }

  /* protocol channels */
  .chan-grid { align-items: stretch; margin-top: 1.8rem; }
  .chan { display: flex; flex-direction: column; height: 100%; }
  .chan-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .chan-scheme { font-size: 1.1rem; }
  .chan-port { font-size: 0.72rem; color: var(--ink-3); }
  .chan-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; margin: 0.85rem 0 0.35rem; letter-spacing: -0.01em; }
  .chan-blurb { font-size: 0.92rem; flex: 1; }

  /* spec rows (mono, justified) */
  .specs { margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed var(--line-2); display: grid; gap: 0.35rem; }
  .spec-row { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--mono); font-size: 0.78rem; }
  .spec-row dt { color: var(--ink-3); }
  .spec-row dd { text-align: right; }

  /* gridftp spotlight */
  .gftp { margin-top: 1rem; border-left: 3px solid var(--ftp); display: grid; gap: 1rem 1.8rem; align-items: start; }
  @media (min-width: 860px) { .gftp { grid-template-columns: 1.7fr 1fr; } }
  .gftp-head { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; grid-column: 1; }
  .gftp-scheme { font-size: 1.1rem; }
  .gftp-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; }
  .gftp-blurb { grid-column: 1; font-size: 0.93rem; }
  .gftp-specs { margin-top: 0; border-top: none; padding-top: 0; }
  @media (min-width: 860px) { .gftp-specs { grid-column: 2; grid-row: 1 / span 2; align-self: center; } }

  /* signal path */
  .flow-intro { max-width: 60ch; margin: 1rem 0 1.8rem; }
  .flow { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.6rem; }
  .flow-step { display: flex; align-items: center; gap: 0.6rem; flex: 1 1 210px; }
  .flow-box {
    flex: 1; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm);
    background: var(--panel); padding: 1rem 1.05rem; display: flex; flex-direction: column; gap: 0.15rem;
    min-height: 96px; border-top: 3px solid var(--tint);
  }
  .flow-n { font-size: 0.66rem; color: var(--ink-3); letter-spacing: 0.08em; }
  .flow-label { font-weight: 700; font-size: 0.98rem; margin-top: 0.2rem; }
  .flow-sub { font-size: 0.72rem; color: var(--ink-2); margin-top: 0.25rem; }
  .flow-arrow { font-size: 1.2rem; color: var(--ink-3); }
  .flow-step:last-child .flow-arrow { display: none; }
  @media (max-width: 620px) {
    .flow-step { flex-basis: 100%; flex-direction: column; gap: 0.35rem; }
    .flow-arrow { transform: rotate(90deg); align-self: center; }
  }

  /* trust + readout */
  .two { margin-top: 1.6rem; gap: 2.4rem; }
  @media (min-width: 820px) { .two { gap: 3rem; } }
  .feature-head { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: 0 0 0.8rem; letter-spacing: -0.02em; }
  .feature > p { max-width: 46ch; }
  .authlist { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.1rem; }
  .tag { border: 1px solid var(--line-2); border-radius: 4px; padding: 0.24em 0.6em; font-size: 0.76rem; color: var(--ink-2); }
  .feature .term { margin-top: 1.1rem; }
  .term .m { color: var(--s3); }

  /* who */
  .whogrid { margin-top: 1.8rem; }
  .who { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .who-name { font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; }
  .who-blurb { font-size: 0.88rem; margin: 0.55rem 0 1rem; flex: 1; }
  .who-go { color: var(--accent); font-weight: 600; font-size: 0.78rem; }
</style>
