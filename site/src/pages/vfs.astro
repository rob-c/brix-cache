<script is:inline>
  /* Row + column crosshair on the capability grid. The grid is fully readable
     without this — every cell carries a visually-hidden state word and the
     header abbr carries the bit name — so a no-JS visitor loses nothing but the
     readout line. */
  (function () {
    var grid = document.getElementById('capgrid');
    var out = document.getElementById('capreadout');
    if (!grid || !out) return;

    var bits = [
      'FD', 'SENDFILE', 'RANDOM_WRITE', 'RANGE_READ', 'TRUNCATE', 'SERVER_COPY',
      'XATTR', 'HARD_RENAME', 'DIRS', 'APPEND', 'IOURING', 'FSCS', 'NEARLINE',
      'CATALOG', 'DIRS_WRITE', 'XATTR_WRITE', 'MEMFILE',
    ];
    var body = grid.tBodies[0];
    var heads = grid.tHead.rows[0].cells;
    var rest = out.innerHTML;

    function clear() {
      var marked = grid.querySelectorAll('.hl');
      for (var i = 0; i < marked.length; i++) marked[i].classList.remove('hl');
    }

    body.addEventListener('mouseover', function (e) {
      var td = e.target.closest ? e.target.closest('td.cap') : null;
      if (!td) return;
      clear();
      var c = +td.dataset.c;
      var row = td.parentNode;
      row.classList.add('hl');
      var col = body.querySelectorAll('td.cap[data-c="' + c + '"]');
      for (var i = 0; i < col.length; i++) col[i].classList.add('hl');
      if (heads[c + 1]) heads[c + 1].classList.add('hl');
      var state = td.classList.contains('on') ? 'advertised'
        : td.classList.contains('cond') ? 'advertised per instance' : 'absent';
      out.innerHTML = row.cells[0].textContent + ' &nbsp;·&nbsp; bit ' + c + ' ' + bits[c] +
        ' &nbsp;·&nbsp; <b>' + state + '</b>';
    });

    body.addEventListener('mouseleave', function () {
      clear();
      out.innerHTML = rest;
    });
  })();
</script>

