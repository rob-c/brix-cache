---
import { url, REPO_URL, DOCS_URL, AUDIENCES, PRODUCT_PAGES } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path.endsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <span class="brand-mark" aria-hidden="true">◍</span>BriX-Cache
    </a>

    <nav class="nav" aria-label="Primary">
      {AUDIENCES.map((a) => (
        <a href={url(a.href)} class:list={['nav-link', { on: isActive(a.href) }]}>{a.label}</a>
      ))}
      {PRODUCT_PAGES.map((p) => (
        <a href={url(p.href)} class:list={['nav-link', { on: isActive(p.href) }]}>{p.label}</a>
      ))}
      <a href={DOCS_URL} class="nav-link">Docs</a>
      <a href={REPO_URL} class="nav-link nav-cta">GitHub ↗</a>

      <button type="button" class="theme-btn" hidden>
        <span class="theme-ico" aria-hidden="true">◐</span><span class="theme-name">AUTO</span>
      </button>
      <script is:inline>
        /* Inline and adjacent to the button so it runs during parse — the label
           is correct on first paint and there is no dead control without JS.
           Cycles auto → light → dark; "auto" removes the key so the media query
           takes over again and later OS changes are followed live. */
        (function () {
          var btn = document.currentScript.previousElementSibling;
          var root = document.documentElement;
          var KEY = 'brix-theme';
          var ORDER = ['auto', 'light', 'dark'];
          var GLYPH = { auto: '◐', light: '○', dark: '●' };

          function stored() {
            try {
              var v = localStorage.getItem(KEY);
              return v === 'light' || v === 'dark' ? v : 'auto';
            } catch (e) {
              return 'auto';
            }
          }

          function apply(mode) {
            if (mode === 'auto') delete root.dataset.theme;
            else root.dataset.theme = mode;
            btn.querySelector('.theme-ico').textContent = GLYPH[mode];
            btn.querySelector('.theme-name').textContent = mode.toUpperCase();
            btn.setAttribute(
              'aria-label',
              'Colour theme: ' + (mode === 'auto' ? 'auto, following your system' : mode) +
                '. Activate to change.'
            );
          }

          apply(stored());
          btn.hidden = false;

          btn.addEventListener('click', function () {
            var next = ORDER[(ORDER.indexOf(stored()) + 1) % ORDER.length];
            try {
              if (next === 'auto') localStorage.removeItem(KEY);
              else localStorage.setItem(KEY, next);
            } catch (e) {}
            apply(next);
          });
        })();
      </script>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
  }
  .brand {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45ch;
  }
  .brand-mark { color: var(--accent); font-size: 1.15em; line-height: 1; }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .nav-link {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.4em 0.65em;
    border-radius: 5px;
    border: 1px solid transparent;
    color: var(--ink-2);
  }
  .nav-link:hover { color: var(--ink); background: var(--band); }
  .nav-link.on { background: color-mix(in srgb, var(--accent) 15%, transparent); border-color: color-mix(in srgb, var(--accent) 34%, transparent); color: var(--accent); }
  .nav-cta { color: var(--ink); border-color: var(--line-2); }
  .nav-cta:hover { border-color: var(--ink-2); background: transparent; }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.4em 0.65em;
    border-radius: 5px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  /* the script unhides it, so no-JS visitors never get a dead control — and
     because that runs during parse there is no layout shift */
  .theme-btn[hidden] { display: none; }
  .theme-btn:hover { color: var(--ink); border-color: var(--ink-2); }
  .theme-ico { font-size: 1.05em; line-height: 1; }

  @media (max-width: 640px) {
    .nav-link:not(.nav-cta) { padding: 0.32em 0.5em; }
    .brand { font-size: 1.15rem; }
    /* aria-label carries the name, so dropping the word costs nothing */
    .theme-name { display: none; }
  }
</style>
