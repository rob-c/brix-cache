# nginx build artifacts (built out-of-tree, but just in case)
objs/
*.o
*.a

# C build artifacts (client + shared + test harnesses)
*.d
!*.d/
*.so
*.pc

# Compiled native-client binaries + test harnesses all land under client/bin/
client/bin/

# Compiled pblock unittest binaries (built in-tree by the pblock test harness)
/pb_ut
/pb_cat_ut

# Benchmark baseline snapshots dropped at repo root by perf comparison runs
/baseline_*.json

# mcp-workspace runtime logs
logs/

# Python
__pycache__/
*.pyc
*.pyo

# editor
*.swp
.DS_Store

# clangd / clang-tidy: the per-file compile DB is machine-specific (absolute
# paths into /tmp/nginx-1.28.3) and regenerable via
# tools/clangd/gen_compile_commands.py; .cache/ is clangd's local index. The
# committed .clangd file carries the portable fallback include/define flags.
/compile_commands.json
.cache/

# local scratch output
.tmp/
.rpmbuild/
.debbuild/
/dist/
# CMake out-of-source build tree (see CMakeLists.txt / BUILD.md)
/build/
/build-*/

# local agent and test caches
.aider*
.aider*/
.opencode/
.ralph/
.claude/
.codex/
.pytest_cache/
.venv/
.venv*/

# URL-shaped paths accidentally created by WebDAV/xrdcp test transfers
davs:/
tests/davs:/

# Local helper scripts not for upstream (PoCs, fuzzer, scratch) — but the
# guard/hook/IDE infrastructure IS upstream: CI and other clones need it.
tools/*
!tools/ci/
!tools/git-hooks/
!tools/clangd/
!tools/gen-docs.sh
# pblock-fsck: the Phase-83 pblock consistency oracle — built and executed by
# the pblock lab tests (test_pblock_lab_*.py), so CI/other clones need it.
!tools/pblock-fsck/
# add_registry_markers: the codemod that writes the per-test
# @pytest.mark.registry_server declarations the fleet-declaration gate enforces
# (its output is committed across the test tree; the tool that regenerates it is not scratch).
!tools/add_registry_markers.py
# readability.py: the single lizard front-end. tools/ci/check_complexity.py
# imports it, so a clone without it cannot run the complexity guard at all —
# it dies on `ModuleNotFoundError: No module named 'readability'` before
# measuring anything. Guarded by tests/test_guard_dependencies.py.
!tools/readability.py
# refactor/: mostly one-shot codemods (scratch), except brix_rebrand.py, which
# check_brix_namespace.py loads by path as its rename engine. Re-ignore the
# directory's contents so a future codemod dropped here stays local by default.
!tools/refactor/
tools/refactor/*
!tools/refactor/brix_rebrand.py
# diag/: local crash and stall probes (scratch), except sd_slot_matrix.py — the
# storage-driver slot matrix is GENERATED, and both the matrix doc and
# src/fs/backend/README.md tell the reader to regenerate/drift-check it with
# this script, so a clone without it cannot verify the census those docs state.
# Re-ignore the directory's contents so a future probe dropped here stays local.
!tools/diag/
tools/diag/*
!tools/diag/sd_slot_matrix.py
# storm_ab_bench.py is exempted for the same reason: the hyper-optimization
# round docs quote its throughput/CPU-per-job tables as the evidence for each
# round's claim, and every BriX-vs-official ratio in them is only reproducible
# with the interleaved A/B driver that lives here.
!tools/diag/storm_ab_bench.py
.aider*

.rpmbuild/
.tmp/

# open-agent-kit: Team
.oak/ci/
.oak/config.*.yaml

# open-agent-kit: Issue raw JSON (local debugging only)
oak
node_modules

# Doxygen generated API docs (run tools/gen-docs.sh)
docs/doxygen/

# Local security proof-of-concept (exploit code; kept out of the repo)
xrootd-session-hijack-poc/

# superpowers brainstorm scratch
.superpowers/

# compiled fuzz harnesses + the copied server binary in the remote suite.
# Matched by shape, not by name: the harness binaries are extensionless and
# their sources are not, so one pair of rules covers every target the roster
# grows (the by-name list had already fallen five behind).
tests/fuzz/fuzz_*
!tests/fuzz/fuzz_*.*
k8s-tests/remote-suite/tests/fuzz/fuzz_*
!k8s-tests/remote-suite/tests/fuzz/fuzz_*.*
k8s-tests/remote-suite/tests/nginx-bin

# versioned shared-lib artifacts (the *.so pattern misses these)
client/libbrix.so.*

# committed-by-accident compiled server binary
tests/nginx-bin

# one-off test-transfer outputs / audit scratch (purged from history 2026-07-05 —
# keep them from ever being re-committed)
bridge_*.bin
bridge_*.txt
eos-write-test.txt
mcp-test-output.txt
/table_body.txt
/sorted_table_body*.txt
/cleaned_table.txt
/current_files.txt
/full_test_files.txt
/mapped_files.txt
/test_files_list.txt
/codebase_audit.list

# actual exploit/attack code — NEVER commit (kept local like xrootd-session-hijack-poc)
bind-exploit.bak/
# large prebuilt python wheel (fetch locally, don't vendor)
*.whl

# local agent/tooling state (never project content)
.omo/
.sisyphus/
opencode.json
/package.json
/package-lock.json
/node_modules/

# gcov instrumentation + lcov reports (coverage builds drop these next to every
# object; the corpus itself is regenerable — see phase92 gcda/lcov tooling)
*.gcno
*.gcda
/coverage/

# crash/leak/timeout reproducers dropped by a failing fuzz run (CI uploads them
# as a build artifact; locally they are throwaway — the corpus is what persists)
tests/fuzz/artifacts/
# ...and the same reproducers when the run forgot `-artifact_prefix` and dropped
# them beside the harnesses instead. A `crash-*` file in the tree reads as an
# open finding; the real ones belong in artifacts/ with the run that found them.
tests/fuzz/crash-*
tests/fuzz/leak-*
tests/fuzz/timeout-*
tests/fuzz/oom-*

# compiled wire-protocol fuzz harnesses (corpus_* seed dirs ARE committed)
tests/fuzz/fuzz_gsi_bucket
tests/fuzz/fuzz_macaroon_frame
tests/fuzz/fuzz_root_frame
tests/fuzz/fuzz_sigv4_canonical
tests/fuzz/fuzz_sss_frame

# locally built RPMs staged for the k8s labs (multi-MB binaries, rebuilt per host)
k8s-tests/rpms/

# repo-root session scratch (probes, captures, local decks)
/strace.pid
/krb5_deleg_capture
/test_zz_probe.py
/August_Status.pptx

# stray test-run logs / captures at the repo root — never commit these
/*.log
/start_log.txt
/testlog*.log
/testlogs*.log
/thistest*.log
/full_suite.log

# patch/merge-tool leftovers from the mechanical refactor passes — the ONLY
# copy of a module is the one in the tree, never a *.orig beside it
*.orig
*.rej
