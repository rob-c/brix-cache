#!/usr/bin/env bash
# Generated by CMake; edit cmake/BrixNginxBuild.sh.in, then rerun cmake.
set -euo pipefail

NGINX_SRC=@NGINX_SOURCE_SHELL@
REPO=@REPO_SHELL@
WORK=@MOD_WORK_SHELL@
BUILDDIR=@MOD_OUT_SHELL@
CC_OPT=@CC_OPT_SHELL@
LD_OPT=@LD_OPT_SHELL@
JOBS=@BRIX_BUILD_JOBS@
CONFIG_ID='@_nginx_config_id@'
# Root config also accepts these build-time environment overrides. Switching
# one must invalidate objects just like changing CMake's compiler/linker flags.
CONFIG_ID=$(printf '%s\0' "$CONFIG_ID" "${BRIX_ENABLE_IO_URING-}" \
    "${BRIX_OPTIMIZE-}" "${BRIX_LZ4_CFLAGS-}" "${BRIX_LZ4_LIBS-}" \
    "${CC-}" "${CFLAGS-}" "${LDFLAGS-}" "${PKG_CONFIG_PATH-}" \
    "${PKG_CONFIG_LIBDIR-}" | sha256sum)
CONFIG_ID=${CONFIG_ID%% *}
STAMP="$WORK/.brix-config-id"
NEEDS_CONFIGURE=0

# These are dedicated CMake outputs, never the caller's nginx source tree.
# Record the identity only after successful configuration, so interrupted
# copies/configures cannot leave a Makefile that looks ready for another build.
if [[ ! -f "$STAMP" ]] || [[ "$(cat "$STAMP")" != "$CONFIG_ID" ]]; then
    echo "[brix] preparing nginx source: $NGINX_SRC -> $WORK"
    rm -rf -- "$WORK" "$BUILDDIR"
    mkdir -p "$WORK" "$BUILDDIR"
    cp -a "$NGINX_SRC/." "$WORK/"
    NEEDS_CONFIGURE=1
fi

cd "$WORK"
if [[ "$NEEDS_CONFIGURE" == 1 ]] || [[ ! -f "$WORK/Makefile" ]] \
    || [[ ! -f "$BUILDDIR/Makefile" ]] || [[ "$REPO/config" -nt "$WORK/Makefile" ]]; then
    echo "[brix] configuring nginx @NGINX_SOURCE_VERSION@"
    rm -f -- "$STAMP"
    ./configure --with-compat \
        --with-cc-opt="$CC_OPT" \
        --with-ld-opt="$LD_OPT" \
        --add-dynamic-module="$REPO" \
        --builddir="$BUILDDIR" \
        --with-threads \
        --with-stream=dynamic \
        --with-stream_ssl_module \
        --with-http_ssl_module \
        --with-http_dav_module
    printf '%s\n' "$CONFIG_ID" > "$STAMP"
fi

TARGET=@NGINX_MAKE_TARGET@
echo "[brix] building nginx $TARGET (-j$JOBS)"
make -C "$WORK" -j"$JOBS" "$TARGET"

ls -l "$BUILDDIR"/ngx_stream_brix_module.so \
      "$BUILDDIR"/ngx_http_brix_xrdhttp_filter_module.so
if [[ "$TARGET" == build ]]; then
    ls -l "$BUILDDIR/nginx"
fi
